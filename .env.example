# Copy to .env.local for local development:  cp .env.example .env.local
# Production URLs never live in a local file — they are set in the Vercel
# dashboard (see docs/deploy.md). Every seed/setup script refuses a non-local
# database host unless ALLOW_REMOTE_SEED=1 is set explicitly.

# ---------------------------------------------------------------- required ---
# Pooled connection used by the running app (Prisma driver adapter).
POSTGRES_URL=postgresql://velo:velo@localhost:5432/velo_atelier
# Direct (unpooled) connection used by migrations and the seed.
POSTGRES_URL_NON_POOLING=postgresql://velo:velo@localhost:5432/velo_atelier

# Auth.js signing secret. Must be at least 32 characters.
# Generate your own with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=dev-only-change-me-0000000000000000000000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Public origin used for canonical URLs, sitemap and OpenGraph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- optional ---
# Google sign-in. Leave empty to develop with email + password only.
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# bcrypt work factor. 12 in dev and production; lower it only in throwaway runs.
BCRYPT_COST=12

# ------------------------------------------------- local / CI test-only -----
# NEVER set any of the three below on Vercel.
# Shows a "fill in the demo account" callout on the sign-in page.
NEXT_PUBLIC_DEMO_LOGIN=1
# Unlocks /dev/bike3d and /dev/bike3d-perf (read at request time).
ENABLE_TEST_PAGES=1
# Compiles the window.__va Playwright hooks into the bundle (build-time gate).
NEXT_PUBLIC_TEST_HOOKS=1
