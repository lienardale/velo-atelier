{
  "name": "velo-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (FR/EN) website that teaches you to inspect, fix, clean and adjust your own bike.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run drawings && next dev",
    "build": "npm run drawings && tsx scripts/content-check.ts && next build",
    "drawings": "tsx scripts/gen-tree-drawings.ts",
    "drawings:check": "tsx scripts/gen-tree-drawings.ts --check",
    "start": "next start",
    "vercel-build": "bash scripts/vercel-build.sh",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && content-collections build && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:bike3d": "vitest run --project bike3d",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project mobile-chromium --project mobile-landscape --project mobile-narrow --project mobile-webkit",
    "e2e:docker": "docker run --rm --platform linux/amd64 --ipc=host --add-host=host.docker.internal:host-gateway -v \"$PWD\":/work -w /work -e CI=1 mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "e2e:update-snapshots": "docker run --rm --platform linux/amd64 --ipc=host --add-host=host.docker.internal:host-gateway -v \"$PWD\":/work -w /work -e CI=1 mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test --grep @snapshot --update-snapshots",
    "perf": "playwright test --project perf --project perf-mobile",
    "perf:local": "playwright test --project perf",
    "lhci": "lhci autorun",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:setup": "bash scripts/db/local.sh --seed",
    "content:check": "tsx scripts/content-check.ts --strict",
    "content:build": "content-collections build && tsx scripts/content-check.ts --emit",
    "content:new": "tsx scripts/content-new.ts",
    "geom:report": "tsx scripts/geometry-report.ts",
    "domain:check": "vitest run --project unit tests/unit/domain --passWithNoTests",
    "ci:local": "bash scripts/ci.sh",
    "prepare": "husky || true",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@content-collections/core": "0.15.2",
    "@content-collections/mdx": "0.2.2",
    "@content-collections/next": "0.2.11",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "bcryptjs": "^3.0.3",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.2",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@content-collections/cli": "0.1.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "audit-ci": "^7.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "remark-mdx": "^3.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.11"
  }
}
