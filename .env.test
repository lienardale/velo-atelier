# Committed on purpose: these are the values CI and the local integration /
# e2e suites run against. Nothing here is a real credential.
# Loaded with `config({ path: '.env.test', override: false })` so a CI `env:`
# block (where the Postgres host is `postgres`, not `localhost`) always wins.
POSTGRES_URL=postgresql://velo:velo@localhost:5432/velo_atelier_t3_test
POSTGRES_URL_NON_POOLING=postgresql://velo:velo@localhost:5432/velo_atelier_t3_test
AUTH_SECRET=ci-only-secret-32-chars-minimum-abcdef
AUTH_URL=http://localhost:3103
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3103
AUTH_GOOGLE_ID=ci-dummy
AUTH_GOOGLE_SECRET=ci-dummy
BCRYPT_COST=4
NEXT_PUBLIC_DEMO_LOGIN=1
ENABLE_TEST_PAGES=1
NEXT_PUBLIC_TEST_HOOKS=1
