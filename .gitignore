# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# lockfiles from other package managers — this repo is npm-only
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# generated code (never committed, never linted, never covered)
/lib/generated/
/.content-collections/
/lib/content/generated/
# NOT ignored, on purpose: public/tree-drawings.json. It is generated
# (scripts/gen-tree-drawings.ts, .debug/005) but committed, because the
# lighthouse and e2e jobs restore only .next/ from the build artifact while
# `next start` serves public/ from the checkout. `scripts/ci/content.sh`
# fails if it is stale.

# test + quality artifacts
/coverage/
/.vitest-reports/
/playwright-report/
/test-results/
/blob-report/
/.lighthouseci/
/.perf/

# env — .env.example and .env.test ARE committed
.env
.env*.local
.env.vercel

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json

# vercel
.vercel

# claude code local overrides (.debug/ and .claude/launch.json ARE committed)
.claude/settings.local.json
